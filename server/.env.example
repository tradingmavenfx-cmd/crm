# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:3000"

# WhatsApp Business (Meta Cloud API) — leave blank to use the dev mock provider
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="dev-verify-token"
WHATSAPP_APP_SECRET=""

# Email (SMTP) — leave SMTP_HOST blank to use the dev mock provider
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="CRM Pro <no-reply@crm.local>"

# SMS (Twilio Programmable Messaging) — leave blank to use the dev mock provider
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
SMS_FROM_NUMBER=""
# Messaging service / DLT entity id required for Indian (TRAI) senders
SMS_DLT_ENTITY_ID=""

# Voice & IVR (Twilio Programmable Voice) — leave blank to use the dev mock provider
VOICE_FROM_NUMBER=""
# Public base URL the telephony platform posts IVR callbacks to (needs a tunnel in dev)
VOICE_PUBLIC_URL="http://localhost:4000/api"
VOICE_STATUS_CALLBACK_URL=""
# Contact score at or above which an inbound caller skips the menu (VIP routing)
VOICE_VIP_SCORE="70"
VOICE_VOICEMAIL_MAX_SEC="120"
# Auto-reply sent after a missed inbound call — set empty to disable
VOICE_MISSED_CALL_SMS="Sorry we missed your call. Our team will call you back shortly."
