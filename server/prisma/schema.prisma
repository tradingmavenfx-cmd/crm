// Enterprise CRM Pro - Prisma Schema
// Phase 1: Foundation & Core
// Multi-tenancy strategy: tenant_id scoping on every row (RLS-ready)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Multi-tenancy
// ─────────────────────────────────────────────

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  domain    String?  @unique
  plan      String   @default("free")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  contacts           Contact[]
  companies          Company[]
  deals              Deal[]
  dealStages         DealStage[]
  activities         Activity[]
  tasks              Task[]
  auditLogs          AuditLog[]
  conversations      Conversation[]
  messages           Message[]
  cannedResponses    CannedResponse[]
  emailTemplates     EmailTemplate[]
  smsTemplates       SmsTemplate[]
  smsOptOuts         SmsOptOut[]
  smsOtps            SmsOtp[]
  ivrFlows           IvrFlow[]
  calls              Call[]
  campaigns          Campaign[]
  campaignRecipients CampaignRecipient[]
  emailEvents        EmailEvent[]
  shortLinks         ShortLink[]
  sequences          Sequence[]
  enrollments        SequenceEnrollment[]
  chatVisitors       ChatVisitor[]
  mentions           Mention[]
  assignmentRules    AssignmentRule[]
  workflows          Workflow[]
  workflowRuns       WorkflowRun[]
  dashboards         Dashboard[]
  dashboardWidgets   DashboardWidget[]
  reportSchedules    ReportSchedule[]
  aiInsights         AiInsight[]
  products           Product[]
  priceBooks         PriceBook[]
  priceBookEntries   PriceBookEntry[]
  quotes             Quote[]
  quoteLines         QuoteLine[]
  discountRules      DiscountRule[]
  invoices           Invoice[]
  tickets            Ticket[]
  ticketComments     TicketComment[]
  ticketEvents       TicketEvent[]
  slaPolicies        SlaPolicy[]
  ticketRules        TicketRule[]
  articles           Article[]
  articleCategories  ArticleCategory[]
  articleVersions    ArticleVersion[]
  articleFeedback    ArticleFeedback[]
  kbSearches         KbSearch[]
  portalLogins       PortalLoginToken[]
  portalSessions     PortalSession[]
  territories        Territory[]
  territoryMembers   TerritoryMember[]
  quotas             Quota[]
  forecastSnapshots  ForecastSnapshot[]
  contests           Contest[]
  badges             Badge[]
  userBadges         UserBadge[]

  @@map("tenants")
}

// ─────────────────────────────────────────────
// Users, Roles & RBAC
// ─────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  MANAGER
  SALES_REP
  SUPPORT_AGENT
  VIEWER
}

model User {
  id           String    @id @default(uuid())
  tenantId     String
  email        String
  passwordHash String
  firstName    String
  lastName     String
  /// Direct/extension number used for IVR transfers and click-to-call
  phone        String?
  role         Role      @default(SALES_REP)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  refreshToken String? // hashed refresh token
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownedContacts         Contact[]          @relation("ContactOwner")
  ownedCompanies        Company[]          @relation("CompanyOwner")
  ownedDeals            Deal[]             @relation("DealOwner")
  activities            Activity[]
  assignedTasks         Task[]             @relation("TaskAssignee")
  createdTasks          Task[]             @relation("TaskCreator")
  auditLogs             AuditLog[]
  assignedConversations Conversation[]     @relation("ConversationAssignee")
  handledCalls          Call[]             @relation("CallAgent")
  createdCampaigns      Campaign[]         @relation("CampaignCreator")
  mentions              Mention[]          @relation("MentionedUser")
  assignmentRules       AssignmentRule[]   @relation("RuleAssignee")
  createdWorkflows      Workflow[]         @relation("WorkflowCreator")
  createdDashboards     Dashboard[]        @relation("DashboardCreator")
  createdQuotes         Quote[]            @relation("QuoteCreator")
  approvedQuotes        Quote[]            @relation("QuoteApprover")
  assignedTickets       Ticket[]           @relation("TicketAssignee")
  ticketComments        TicketComment[]    @relation("TicketCommentAuthor")
  ticketRules           TicketRule[]       @relation("TicketRuleAssignee")
  authoredArticles      Article[]          @relation("ArticleAuthor")
  managedTerritories    Territory[]        @relation("TerritoryManager")
  territoryMemberships  TerritoryMember[]
  quotas                Quota[]            @relation("QuotaOwner")
  forecastSnapshots     ForecastSnapshot[] @relation("ForecastOwner")
  badges                UserBadge[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ─────────────────────────────────────────────
// Core CRM
// ─────────────────────────────────────────────

model Company {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  domain    String?
  industry  String?
  website   String?
  phone     String?
  employees Int?
  annualRev Decimal? @db.Decimal(18, 2)
  ownerId   String?

  /// Where the account sits, for geographic territories
  city    String?
  state   String?
  country String?

  /// Set by the territory rules, or pinned by hand
  territoryId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner     User?      @relation("CompanyOwner", fields: [ownerId], references: [id])
  territory Territory? @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  contacts  Contact[]
  deals     Deal[]
  quotes    Quote[]

  @@index([tenantId])
  @@index([tenantId, territoryId])
  @@map("companies")
}

model Contact {
  id        String   @id @default(uuid())
  tenantId  String
  firstName String
  lastName  String
  email     String?
  phone     String?
  jobTitle  String?
  companyId String?
  ownerId   String?
  score     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company            Company?             @relation(fields: [companyId], references: [id])
  owner              User?                @relation("ContactOwner", fields: [ownerId], references: [id])
  deals              Deal[]
  activities         Activity[]
  conversations      Conversation[]
  calls              Call[]
  campaignRecipients CampaignRecipient[]
  enrollments        SequenceEnrollment[]
  quotes             Quote[]
  tickets            Ticket[]
  portalLogins       PortalLoginToken[]
  portalSessions     PortalSession[]

  @@index([tenantId])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@map("contacts")
}

model DealStage {
  id          String @id @default(uuid())
  tenantId    String
  name        String
  order       Int
  probability Int    @default(0) // 0-100

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deals  Deal[]

  @@index([tenantId])
  @@map("deal_stages")
}

model Deal {
  id        String  @id @default(uuid())
  tenantId  String
  title     String
  value     Decimal @default(0) @db.Decimal(18, 2)
  currency  String  @default("INR")
  stageId   String
  companyId String?
  contactId String?
  ownerId   String?
  status    String  @default("open") // open | won | lost

  /// The rep's own call on the deal. Null means "derive it from the stage",
  /// so a forecast works before anyone has categorised anything.
  forecastCategory ForecastCategory?

  expectedAt DateTime?
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stage      DealStage  @relation(fields: [stageId], references: [id])
  company    Company?   @relation(fields: [companyId], references: [id])
  contact    Contact?   @relation(fields: [contactId], references: [id])
  owner      User?      @relation("DealOwner", fields: [ownerId], references: [id])
  activities Activity[]
  quotes     Quote[]

  @@index([tenantId])
  @@index([tenantId, stageId])
  @@map("deals")
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  TASK
  WHATSAPP
}

model Activity {
  id        String       @id @default(uuid())
  tenantId  String
  type      ActivityType
  subject   String
  body      String?
  userId    String
  contactId String?
  dealId    String?
  createdAt DateTime     @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id])
  deal    Deal?    @relation(fields: [dealId], references: [id])

  @@index([tenantId])
  @@map("activities")
}

model Task {
  id          String    @id @default(uuid())
  tenantId    String
  title       String
  description String?
  dueAt       DateTime?
  priority    String    @default("medium") // low | medium | high
  status      String    @default("open") // open | in_progress | done
  assigneeId  String?
  creatorId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignee User?  @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator  User   @relation("TaskCreator", fields: [creatorId], references: [id])

  @@index([tenantId])
  @@map("tasks")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// Communication Hub (Phase 2) — omnichannel foundation
// ─────────────────────────────────────────────

enum Channel {
  WHATSAPP
  EMAIL
  SMS
  LIVE_CHAT
  VOICE
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

model Conversation {
  id            String   @id @default(uuid())
  tenantId      String
  channel       Channel  @default(WHATSAPP)
  // External participant identifier (e.g. WhatsApp phone in E.164)
  externalId    String
  contactId     String?
  assignedToId  String?
  status        String   @default("open") // open | pending | closed
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  firstResponseAt DateTime?

  /// Post-chat rating (1-5) and optional comment, collected by the widget
  rating        Int?
  ratingComment String?

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact    Contact?      @relation(fields: [contactId], references: [id])
  assignedTo User?         @relation("ConversationAssignee", fields: [assignedToId], references: [id])
  messages   Message[]
  calls      Call[]
  visitors   ChatVisitor[]
  tickets    Ticket[]

  @@unique([tenantId, channel, externalId])
  @@index([tenantId, channel])
  @@index([tenantId, lastMessageAt])
  @@index([tenantId, assignedToId])
  @@map("conversations")
}

model Message {
  id             String           @id @default(uuid())
  tenantId       String
  conversationId String
  channel        Channel          @default(WHATSAPP)
  direction      MessageDirection
  type           String           @default("text") // text | template | image | document | note
  subject        String? // used by email channel
  body           String?
  // Internal notes are visible to agents only, never sent to the customer
  isInternal     Boolean          @default(false)
  authorId       String?
  // Provider-side message id (e.g. WhatsApp wamid) for status callbacks
  externalId     String?
  status         MessageStatus    @default(QUEUED)
  metadata       Json?
  createdAt      DateTime         @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  events       EmailEvent[]
  mentions     Mention[]

  @@index([tenantId, conversationId])
  @@index([externalId])
  @@map("messages")
}

model CannedResponse {
  id        String   @id @default(uuid())
  tenantId  String
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("canned_responses")
}

model EmailTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  subject   String
  body      String // HTML or plain text with {{merge}} fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("email_templates")
}

// ─────────────────────────────────────────────
// IVR & Cloud Telephony (Phase 2.2)
// ─────────────────────────────────────────────

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  QUEUED
  RINGING
  IN_PROGRESS
  COMPLETED
  MISSED
  BUSY
  FAILED
  VOICEMAIL
}

/// A multi-level IVR menu. Levels are composed by pointing a `menu` option at
/// another flow, which keeps each level independently editable.
model IvrFlow {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  /// Prompt played before the menu ("Welcome to Acme. For sales, press 1…")
  greeting    String
  /// Only one flow per tenant answers inbound calls.
  isActive    Boolean  @default(false)
  /// Menu options: [{ digit, label, action, value }] where action is one of
  /// menu | transfer | voicemail | message | crm_lookup | hangup
  options     Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calls  Call[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("ivr_flows")
}

model Call {
  id           String        @id @default(uuid())
  tenantId     String
  direction    CallDirection
  /// Caller number (E.164) — the customer on inbound, the virtual number on outbound
  from         String
  to           String
  status       CallStatus    @default(QUEUED)
  /// Provider-side call id (e.g. Twilio CallSid) for status callbacks
  externalId   String?
  durationSec  Int           @default(0)
  recordingUrl String?
  /// Voicemail / recording transcription
  transcript   String?
  /// DTMF digits pressed, in order, across the IVR tree
  ivrPath      String[]      @default([])

  contactId      String?
  agentId        String?
  ivrFlowId      String?
  conversationId String?

  startedAt  DateTime  @default(now())
  answeredAt DateTime?
  endedAt    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact      Contact?      @relation(fields: [contactId], references: [id])
  agent        User?         @relation("CallAgent", fields: [agentId], references: [id])
  ivrFlow      IvrFlow?      @relation(fields: [ivrFlowId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId, startedAt])
  @@index([tenantId, agentId])
  @@index([tenantId, status])
  @@index([externalId])
  @@map("calls")
}

// ─────────────────────────────────────────────
// SMS (Phase 2.4)
// ─────────────────────────────────────────────

model SmsTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  /// Plain text with {{merge}} fields
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("sms_templates")
}

/// TRAI/DND compliance — numbers that must never receive an SMS from this tenant.
model SmsOptOut {
  id        String   @id @default(uuid())
  tenantId  String
  phone     String
  /// stop_keyword | manual | dnd_registry
  reason    String   @default("stop_keyword")
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("sms_opt_outs")
}

model SmsOtp {
  id         String    @id @default(uuid())
  tenantId   String
  phone      String
  /// bcrypt hash — the plaintext code is only ever sent over SMS
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, phone])
  @@map("sms_otps")
}

// -----------------------------------------------------------
// Campaigns - broadcast & bulk send (Phase 2.1 / 2.3 / 2.4)
// -----------------------------------------------------------

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
}

model Campaign {
  id       String         @id @default(uuid())
  tenantId String
  name     String
  channel  Channel
  status   CampaignStatus @default(DRAFT)

  /// Email subject; unused on other channels
  subject              String?
  /// Message body, with {{merge}} fields
  body                 String?
  /// Optional saved template to render from (email or SMS)
  templateId           String?
  /// WhatsApp needs a pre-approved template name for business-initiated sends
  whatsappTemplateName String?

  /// Audience filter: { contactIds?, minScore?, companyId?, ownerId? }
  segment     Json      @default("{}")
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy  User?               @relation("CampaignCreator", fields: [createdById], references: [id])
  recipients CampaignRecipient[]

  @@index([tenantId, status])
  @@index([tenantId, scheduledAt])
  @@map("campaigns")
}

model CampaignRecipient {
  id         String    @id @default(uuid())
  tenantId   String
  campaignId String
  contactId  String?
  /// Email address or phone number actually used
  address    String
  /// pending | sent | skipped | failed
  status     String    @default("pending")
  /// Why a recipient was skipped or failed (opted_out, no_address, provider error)
  reason     String?
  /// The Message row created for this send, if any
  messageId  String?
  sentAt     DateTime?
  openedAt   DateTime?
  clickedAt  DateTime?
  createdAt  DateTime  @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact? @relation(fields: [contactId], references: [id])

  @@unique([campaignId, address])
  @@index([tenantId, campaignId])
  @@map("campaign_recipients")
}

// -----------------------------------------------------------
// Email open/click tracking (Phase 2.3)
// -----------------------------------------------------------

model EmailEvent {
  id        String   @id @default(uuid())
  tenantId  String
  messageId String
  /// open | click
  type      String
  /// Destination for a click event
  url       String?
  userAgent String?
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([tenantId, messageId])
  @@index([tenantId, type])
  @@map("email_events")
}

/// Trackable short links - used for click tracking in SMS and email bodies.
model ShortLink {
  id         String   @id @default(uuid())
  tenantId   String
  code       String   @unique
  url        String
  messageId  String?
  campaignId String?
  clicks     Int      @default(0)
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("short_links")
}

// -----------------------------------------------------------
// Email sequences - automated follow-up chains (Phase 2.3)
// -----------------------------------------------------------

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  STOPPED
}

model Sequence {
  id          String  @id @default(uuid())
  tenantId    String
  name        String
  description String?
  isActive    Boolean @default(true)
  /// Stop the chain as soon as the contact replies on this channel
  stopOnReply Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps       SequenceStep[]
  enrollments SequenceEnrollment[]

  @@index([tenantId])
  @@map("sequences")
}

model SequenceStep {
  id         String @id @default(uuid())
  sequenceId String
  /// 0-based position in the chain
  order      Int
  /// Wait this long after the previous step before sending
  delayHours Int    @default(24)
  subject    String
  body       String

  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, order])
  @@map("sequence_steps")
}

model SequenceEnrollment {
  id          String           @id @default(uuid())
  tenantId    String
  sequenceId  String
  contactId   String
  status      EnrollmentStatus @default(ACTIVE)
  /// Index of the next step to send
  currentStep Int              @default(0)
  nextRunAt   DateTime
  stopReason  String?
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, contactId])
  @@index([tenantId, status, nextRunAt])
  @@map("sequence_enrollments")
}

// -----------------------------------------------------------
// Live chat (Phase 2.4)
// -----------------------------------------------------------

/// A website visitor talking to the team through the chat widget. The thread
/// itself is a Conversation on the LIVE_CHAT channel.
model ChatVisitor {
  id         String @id @default(uuid())
  tenantId   String
  /// Opaque key held by the browser, used to resume a session
  visitorKey String @unique

  name        String?
  email       String?
  /// Page the visitor is on right now, for agent context
  currentPage String?
  userAgent   String?
  /// Number of pages seen this session
  pageViews   Int      @default(1)
  startedAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  conversationId String?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([tenantId, lastSeenAt])
  @@map("chat_visitors")
}

// -----------------------------------------------------------
// Team collaboration & routing (Phase 2.6)
// -----------------------------------------------------------

/// An @mention of a teammate inside an internal note.
model Mention {
  id        String    @id @default(uuid())
  tenantId  String
  messageId String
  userId    String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation("MentionedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([tenantId, userId, readAt])
  @@map("mentions")
}

/// Routes new conversations to an agent automatically.
model AssignmentRule {
  id         String   @id @default(uuid())
  tenantId   String
  name       String
  isActive   Boolean  @default(true)
  /// Lower runs first; the first matching rule wins
  priority   Int      @default(0)
  /// Limit the rule to one channel, or leave null for all
  channel    Channel?
  /// Match on message text: { keywords: ["refund", "invoice"] }
  conditions Json     @default("{}")
  /// specific | round_robin
  strategy   String   @default("specific")
  assignToId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignTo User?  @relation("RuleAssignee", fields: [assignToId], references: [id])

  @@index([tenantId, isActive, priority])
  @@map("assignment_rules")
}

// -----------------------------------------------------------
// Workflow automation engine (Phase 3.2)
// -----------------------------------------------------------

enum WorkflowTrigger {
  RECORD_CREATED
  RECORD_UPDATED
  FIELD_CHANGED
  DEAL_STAGE_CHANGED
  MESSAGE_RECEIVED
  CALL_COMPLETED
  SCHEDULE
  WEBHOOK
}

enum WorkflowRunStatus {
  SUCCESS
  FAILED
  SKIPPED
}

model Workflow {
  id          String          @id @default(uuid())
  tenantId    String
  name        String
  description String?
  isActive    Boolean         @default(true)
  trigger     WorkflowTrigger

  /// Which record type a record trigger watches: contact | company | deal | task
  triggerEntity String?
  /// Trigger detail, by trigger type:
  ///   FIELD_CHANGED   { field, to? }
  ///   MESSAGE_RECEIVED{ channel? }
  ///   SCHEDULE        { everyMinutes } or { dailyAt: "09:00" }
  ///   WEBHOOK         { key }
  triggerConfig Json    @default("{}")

  /// Condition tree: { all: [...] } / { any: [...] }, leaves { field, op, value }
  conditions Json @default("{}")
  /// Ordered steps: [{ type, config }]
  actions    Json @default("[]")

  runCount  Int       @default(0)
  lastRunAt DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?         @relation("WorkflowCreator", fields: [createdById], references: [id])
  runs      WorkflowRun[]

  @@index([tenantId, isActive, trigger])
  @@map("workflows")
}

model WorkflowRun {
  id         String            @id @default(uuid())
  tenantId   String
  workflowId String
  status     WorkflowRunStatus

  /// The event that fired the workflow
  triggerPayload Json
  /// Per-action outcome: [{ type, status, detail }]
  steps          Json     @default("[]")
  /// Why the run was skipped (conditions not met) or how it failed
  message        String?
  durationMs     Int      @default(0)
  createdAt      DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([tenantId, workflowId, createdAt])
  @@index([tenantId, status])
  @@map("workflow_runs")
}

// -----------------------------------------------------------
// Analytics & BI (Phase 3.3)
// -----------------------------------------------------------

model Dashboard {
  id             String  @id @default(uuid())
  tenantId       String
  name           String
  description    String?
  /// Shown first when someone opens the dashboards page
  isDefault      Boolean @default(false)
  /// Roles allowed to see it. Empty means everyone in the tenant.
  visibleToRoles Role[]  @default([])

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?             @relation("DashboardCreator", fields: [createdById], references: [id])
  widgets   DashboardWidget[]

  @@index([tenantId])
  @@map("dashboards")
}

model DashboardWidget {
  id          String @id @default(uuid())
  tenantId    String
  dashboardId String
  title       String
  /// Which report feeds this widget, e.g. "sales.pipeline"
  reportKey   String
  /// How to draw it: bar | line | donut | funnel | table | stat
  chart       String @default("bar")
  /// Report parameters, e.g. { days: 30 }
  params      Json   @default("{}")
  /// Order on the dashboard, lowest first
  position    Int    @default(0)
  /// half | full
  width       String @default("half")

  createdAt DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([tenantId, dashboardId, position])
  @@map("dashboard_widgets")
}

/// Emails a report to a list of addresses on a fixed cadence.
model ReportSchedule {
  id         String    @id @default(uuid())
  tenantId   String
  name       String
  reportKey  String
  /// daily | weekly | monthly
  frequency  String    @default("weekly")
  /// Local time of day to send, "HH:MM"
  sendAt     String    @default("09:00")
  /// Where to send it
  recipients String[]
  params     Json      @default("{}")
  isActive   Boolean   @default(true)
  lastSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@map("report_schedules")
}

// -----------------------------------------------------------
// AI intelligence (Phase 3.1)
// -----------------------------------------------------------

enum InsightType {
  LEAD_SCORE
  DEAL_RISK
  NEXT_ACTION
  SENTIMENT
}

/// The latest AI judgement about one record. Scores are always explainable:
/// `factors` carries the signals that moved the number, so a rep can see why.
model AiInsight {
  id       String      @id @default(uuid())
  tenantId String
  type     InsightType

  /// contact | deal | conversation
  entityType String
  entityId   String

  /// 0-100 for scores and probabilities; -100..100 for sentiment
  score   Float?
  /// hot | warm | cold | at_risk | healthy | positive | neutral | negative
  label   String?
  /// One or two sentences a person can act on
  summary String
  /// [{ label, impact, detail }] - impact is the points contributed
  factors Json    @default("[]")

  /// Which provider produced it: mock | openai
  source String
  model  String?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId, type])
  @@index([tenantId, type, createdAt])
  @@map("ai_insights")
}

// -----------------------------------------------------------
// CPQ - products, price books, quotes (Phase 4.1)
// -----------------------------------------------------------

model Product {
  id          String  @id @default(uuid())
  tenantId    String
  /// Stock-keeping unit, unique inside the tenant
  sku         String
  name        String
  description String?

  /// List price in the tenant's base currency, in major units
  unitPrice Decimal @db.Decimal(18, 2)
  currency  String  @default("INR")
  /// GST rate applied to this product
  taxRate   Decimal @default(18) @db.Decimal(5, 2)
  /// Indian HSN (goods) or SAC (services) classification code
  hsnCode   String?
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prices PriceBookEntry[]
  lines  QuoteLine[]

  @@unique([tenantId, sku])
  @@index([tenantId, isActive])
  @@map("products")
}

/// A named set of prices - one per currency or per customer segment.
model PriceBook {
  id        String  @id @default(uuid())
  tenantId  String
  name      String
  currency  String  @default("INR")
  /// Used when a quote does not name one
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries PriceBookEntry[]
  quotes  Quote[]

  @@index([tenantId])
  @@map("price_books")
}

model PriceBookEntry {
  id          String  @id @default(uuid())
  tenantId    String
  priceBookId String
  productId   String
  unitPrice   Decimal @db.Decimal(18, 2)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priceBook PriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceBookId, productId])
  @@index([tenantId])
  @@map("price_book_entries")
}

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

model Quote {
  id       String      @id @default(uuid())
  tenantId String
  /// Human-facing reference, e.g. Q-2026-0001
  number   String
  status   QuoteStatus @default(DRAFT)

  dealId      String?
  contactId   String?
  companyId   String?
  priceBookId String?

  currency        String  @default("INR")
  /// Discount applied to the whole quote, on top of any line discounts
  discountPercent Decimal @default(0) @db.Decimal(5, 2)

  /// Totals are stored as computed, so a sent quote never changes underfoot
  subtotal       Decimal @default(0) @db.Decimal(18, 2)
  discountAmount Decimal @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal @default(0) @db.Decimal(18, 2)
  total          Decimal @default(0) @db.Decimal(18, 2)

  validUntil DateTime?
  notes      String?
  terms      String?

  /// Unguessable token behind the customer-facing link
  publicToken String @unique

  sentAt          DateTime?
  acceptedAt      DateTime?
  declinedAt      DateTime?
  /// Who accepted, captured from the public page. An acceptance record, not a
  /// legally integrated e-signature.
  acceptedByName  String?
  acceptedByEmail String?
  acceptedIp      String?
  declineReason   String?

  /// Set when the discount exceeded what the creator may approve themselves
  approvalRequired Boolean   @default(false)
  approvedById     String?
  approvedAt       DateTime?
  rejectionReason  String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal       Deal?       @relation(fields: [dealId], references: [id], onDelete: SetNull)
  contact    Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company    Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  priceBook  PriceBook?  @relation(fields: [priceBookId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation("QuoteCreator", fields: [createdById], references: [id])
  approvedBy User?       @relation("QuoteApprover", fields: [approvedById], references: [id])
  lines      QuoteLine[]
  invoices   Invoice[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("quotes")
}

model QuoteLine {
  id        String  @id @default(uuid())
  tenantId  String
  quoteId   String
  /// Null for a free-text line that is not in the catalogue
  productId String?

  name            String
  description     String?
  quantity        Decimal @default(1) @db.Decimal(12, 2)
  unitPrice       Decimal @db.Decimal(18, 2)
  /// Discount on this line alone
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  taxRate         Decimal @default(18) @db.Decimal(5, 2)
  /// Line total after its own discount, before tax
  lineTotal       Decimal @default(0) @db.Decimal(18, 2)
  position        Int     @default(0)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([tenantId, quoteId, position])
  @@map("quote_lines")
}

/// How much discount a role may give before a quote needs approval.
model DiscountRule {
  id       String  @id @default(uuid())
  tenantId String
  name     String
  isActive Boolean @default(true)
  /// Lower runs first; the first rule matching the creator's role wins
  priority Int     @default(0)

  /// Roles this limit applies to. Empty means everyone.
  appliesToRoles     Role[]  @default([])
  /// Discount percent this role may approve without asking
  maxDiscountPercent Decimal @default(10) @db.Decimal(5, 2)
  /// Role that must approve anything above the limit
  approverRole       Role    @default(MANAGER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive, priority])
  @@map("discount_rules")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

/// Raised from an accepted quote; totals are copied, never recomputed.
model Invoice {
  id       String        @id @default(uuid())
  tenantId String
  number   String
  status   InvoiceStatus @default(DRAFT)
  quoteId  String?

  currency       String  @default("INR")
  subtotal       Decimal @db.Decimal(18, 2)
  discountAmount Decimal @db.Decimal(18, 2)
  taxAmount      Decimal @db.Decimal(18, 2)
  total          Decimal @db.Decimal(18, 2)

  issuedAt      DateTime?
  dueAt         DateTime?
  paidAt        DateTime?
  /// GSTIN of the customer, for a compliant Indian invoice
  customerGstin String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote  Quote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("invoices")
}

// -----------------------------------------------------------
// Service Cloud - ticketing (Phase 4.3)
// -----------------------------------------------------------

enum TicketStatus {
  OPEN
  PENDING
  ON_HOLD
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Response and resolution targets, in minutes, keyed by priority.
model SlaPolicy {
  id        String  @id @default(uuid())
  tenantId  String
  name      String
  isActive  Boolean @default(true)
  /// Applied to tickets that name no policy
  isDefault Boolean @default(false)

  /// { "LOW": 480, "MEDIUM": 240, "HIGH": 60, "URGENT": 30 }
  firstResponseMinutes Json
  resolutionMinutes    Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@index([tenantId, isActive])
  @@map("sla_policies")
}

/// Categorises, prioritises and routes a new ticket. The first matching rule
/// wins, so ordering by priority is what makes the set predictable.
model TicketRule {
  id       String  @id @default(uuid())
  tenantId String
  name     String
  isActive Boolean @default(true)
  priority Int     @default(0)

  /// { keywords: ["refund"], channel: "EMAIL" }
  conditions Json @default("{}")

  setCategory String?
  setPriority TicketPriority?
  /// specific | round_robin | load_based
  strategy    String          @default("specific")
  assignToId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignTo User?  @relation("TicketRuleAssignee", fields: [assignToId], references: [id])

  @@index([tenantId, isActive, priority])
  @@map("ticket_rules")
}

model Ticket {
  id          String         @id @default(uuid())
  tenantId    String
  /// Human-facing reference, e.g. T-2026-0001
  number      String
  subject     String
  description String?
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  category    String?
  tags        String[]       @default([])

  /// Where it came from, when it was raised from a conversation or a call
  channel        Channel?
  requesterId    String?
  assigneeId     String?
  conversationId String?
  slaPolicyId    String?

  /// SLA clocks, set when the ticket is created from its policy
  firstResponseDueAt    DateTime?
  resolutionDueAt       DateTime?
  firstRespondedAt      DateTime?
  resolvedAt            DateTime?
  closedAt              DateTime?
  firstResponseBreached Boolean   @default(false)
  resolutionBreached    Boolean   @default(false)

  /// Parent-child: a child tracks part of its parent's work
  parentId     String?
  /// Set when this ticket was merged into another; it stops being worked
  mergedIntoId String?

  /// Post-resolution survey, collected through an unguessable link
  csatToken   String  @unique
  csatRating  Int?
  csatComment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requester    Contact?        @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  assignee     User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  conversation Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  slaPolicy    SlaPolicy?      @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  parent       Ticket?         @relation("TicketChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children     Ticket[]        @relation("TicketChildren")
  mergedInto   Ticket?         @relation("TicketMerges", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Ticket[]        @relation("TicketMerges")
  comments     TicketComment[]
  events       TicketEvent[]

  @@unique([tenantId, number])
  @@index([tenantId, status, priority])
  @@index([tenantId, assigneeId])
  @@map("tickets")
}

model TicketComment {
  id         String   @id @default(uuid())
  tenantId   String
  ticketId   String
  authorId   String?
  body       String
  /// Internal notes are never shown to the requester
  isInternal Boolean  @default(false)
  /// Set when the reply also went out on a channel
  channel    Channel?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?  @relation("TicketCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([tenantId, ticketId, createdAt])
  @@map("ticket_comments")
}

/// Audit trail: who changed what, and when.
model TicketEvent {
  id       String  @id @default(uuid())
  tenantId String
  ticketId String
  /// created | status | priority | assigned | merged | linked | sla_breach | csat
  type     String
  detail   Json    @default("{}")
  userId   String?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([tenantId, ticketId, createdAt])
  @@map("ticket_events")
}

// -----------------------------------------------------------
// Knowledge base (Phase 4.3)
// -----------------------------------------------------------

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ArticleVisibility {
  /// Visible in the customer-facing help centre
  PUBLIC
  /// Agents only
  INTERNAL
}

model ArticleCategory {
  id          String  @id @default(uuid())
  tenantId    String
  name        String
  slug        String
  description String?
  position    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  articles Article[]

  @@unique([tenantId, slug])
  @@index([tenantId, position])
  @@map("article_categories")
}

model Article {
  id       String  @id @default(uuid())
  tenantId String
  /// URL segment, unique per tenant and locale
  slug     String
  title    String
  /// Short summary shown in listings and search results
  excerpt  String?
  body     String

  status     ArticleStatus     @default(DRAFT)
  visibility ArticleVisibility @default(PUBLIC)
  categoryId String?
  tags       String[]          @default([])

  /// BCP-47 language tag, e.g. "en" or "hi"
  locale          String  @default("en")
  /// Points at the original when this article is a translation of it
  translationOfId String?

  /// Bumped on every published revision; the body of each is kept
  version Int @default(1)

  authorId    String?
  publishedAt DateTime?

  viewCount       Int @default(0)
  helpfulCount    Int @default(0)
  notHelpfulCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category      ArticleCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author        User?             @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  translationOf Article?          @relation("ArticleTranslations", fields: [translationOfId], references: [id], onDelete: SetNull)
  translations  Article[]         @relation("ArticleTranslations")
  versions      ArticleVersion[]
  feedback      ArticleFeedback[]

  @@unique([tenantId, locale, slug])
  @@index([tenantId, status, visibility])
  @@index([tenantId, categoryId])
  @@map("articles")
}

/// A snapshot of an article as it was published, so an edit can be rolled back.
model ArticleVersion {
  id        String  @id @default(uuid())
  tenantId  String
  articleId String
  version   Int
  title     String
  body      String
  authorId  String?
  /// What changed, when the author bothered to say
  note      String?

  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, version])
  @@index([tenantId, articleId])
  @@map("article_versions")
}

model ArticleFeedback {
  id        String  @id @default(uuid())
  tenantId  String
  articleId String
  helpful   Boolean
  comment   String?

  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([tenantId, articleId])
  @@map("article_feedback")
}

/// Every search, so the gaps in the knowledge base are visible.
model KbSearch {
  id          String  @id @default(uuid())
  tenantId    String
  query       String
  /// How many articles the search returned; zero is the interesting case
  resultCount Int
  /// Set for an agent search; null when it came from the help centre
  userId      String?
  /// public | agent
  source      String  @default("public")

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, resultCount])
  @@map("kb_searches")
}

// ── Customer portal ────────────────────────────
//
// Customers sign in with a link emailed to them, never a password: the CRM
// then holds no customer credentials to leak. Both tokens are stored as
// SHA-256 hashes, so a dump of these tables cannot be replayed as a login.

/// A single-use link emailed to a contact so they can open the portal.
model PortalLoginToken {
  id         String    @id @default(uuid())
  tenantId   String
  contactId  String
  tokenHash  String    @unique
  expiresAt  DateTime
  /// Set the moment it is exchanged for a session, so a forwarded link is dead
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, contactId, createdAt])
  @@map("portal_login_tokens")
}

/// The session a consumed link opens. Revocable, and scoped to one contact.
model PortalSession {
  id         String    @id @default(uuid())
  tenantId   String
  contactId  String
  tokenHash  String    @unique
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, contactId])
  @@map("portal_sessions")
}

// ─────────────────────────────────────────────
// Territories, quotas, forecasting, gamification
// ─────────────────────────────────────────────

/// A slice of the market, owned by a group of reps. Territories nest, so a
/// country can contain regions and a region can contain cities.
model Territory {
  id          String  @id @default(uuid())
  tenantId    String
  name        String
  description String?
  parentId    String?
  managerId   String?
  isActive    Boolean @default(true)

  /// Matched against a company to assign it automatically. Empty means the
  /// territory is hand-picked only.
  rules Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    Territory?         @relation("TerritoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Territory[]        @relation("TerritoryTree")
  manager   User?              @relation("TerritoryManager", fields: [managerId], references: [id], onDelete: SetNull)
  members   TerritoryMember[]
  companies Company[]
  quotas    Quota[]
  snapshots ForecastSnapshot[]

  @@unique([tenantId, name])
  @@index([tenantId, parentId])
  @@map("territories")
}

model TerritoryMember {
  id          String @id @default(uuid())
  tenantId    String
  territoryId String
  userId      String

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  territory Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([territoryId, userId])
  @@index([tenantId, userId])
  @@map("territory_members")
}

enum QuotaPeriod {
  MONTH
  QUARTER
  YEAR
}

/// What a rep or a territory is expected to close in a period.
model Quota {
  id          String      @id @default(uuid())
  tenantId    String
  /// Exactly one of these is set: a quota belongs to a person or to a territory
  ownerId     String?
  territoryId String?
  period      QuotaPeriod
  periodStart DateTime
  amount      Decimal     @db.Decimal(18, 2)
  currency    String      @default("INR")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner     User?      @relation("QuotaOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  territory Territory? @relation(fields: [territoryId], references: [id], onDelete: Cascade)

  @@index([tenantId, periodStart])
  @@map("quotas")
}

enum ForecastCategory {
  OMITTED
  PIPELINE
  BEST_CASE
  COMMIT
  CLOSED
}

/// What the forecast said on a given day, kept so the call can be scored
/// against what actually happened.
model ForecastSnapshot {
  id          String      @id @default(uuid())
  tenantId    String
  ownerId     String?
  territoryId String?
  period      QuotaPeriod
  periodStart DateTime
  takenAt     DateTime    @default(now())

  closed   Decimal @db.Decimal(18, 2)
  commit   Decimal @db.Decimal(18, 2)
  bestCase Decimal @db.Decimal(18, 2)
  pipeline Decimal @db.Decimal(18, 2)
  weighted Decimal @db.Decimal(18, 2)
  quota    Decimal @db.Decimal(18, 2)

  /// Filled in once the period is over, which is what makes accuracy real
  actual Decimal? @db.Decimal(18, 2)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner     User?      @relation("ForecastOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  territory Territory? @relation(fields: [territoryId], references: [id], onDelete: Cascade)

  @@index([tenantId, periodStart])
  @@index([tenantId, ownerId, periodStart])
  @@map("forecast_snapshots")
}

enum ContestMetric {
  REVENUE_WON
  DEALS_WON
  CALLS_MADE
  MEETINGS_HELD
  TICKETS_RESOLVED
}

/// A time-boxed competition on one metric.
model Contest {
  id       String        @id @default(uuid())
  tenantId String
  name     String
  metric   ContestMetric
  startsAt DateTime
  endsAt   DateTime
  prize    String?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startsAt])
  @@map("contests")
}

/// Earned once and kept. The standing is recomputed from the records, but an
/// award is a fact about a moment and is written down.
model Badge {
  id          String        @id @default(uuid())
  tenantId    String
  key         String
  name        String
  description String
  icon        String        @default("star")
  metric      ContestMetric
  /// What it takes to earn it, measured over all time
  threshold   Decimal       @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  earned UserBadge[]

  @@unique([tenantId, key])
  @@map("badges")
}

model UserBadge {
  id       String   @id @default(uuid())
  tenantId String
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  /// The figure that earned it, so the award can be explained later
  value    Decimal  @db.Decimal(18, 2)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge  Badge  @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([tenantId, userId])
  @@map("user_badges")
}
